  "plots": {
    "reference": "paper/data/whole_body_control/agent_controller_v1/reference_agent_delivery.png",
    "learned": "paper/data/whole_body_control/agent_controller_v1/learned_agent_lift.png",
    "source": "\"\"\"Measured task errors with the actual Cartesian path and endpoint bounds.\"\"\"\nimport gzip\nimport json\nfrom pathlib import Path\nimport matplotlib\nmatplotlib.use('Agg')\nimport matplotlib.pyplot as plt\nimport numpy as np\n\nroot=Path('paper/data/whole_body_control/agent_controller_v1')\ndef plot(ep,path):\n    trace=ep['trace'];t=np.array([r['time'] for r in trace])\n    h=np.array([r['hand'] for r in trace]);g=np.array([r['hand_goal'] for r in trace])\n    def rotations(x):\n        c=x[:,3:].reshape(-1,3,2)\n        return np.concatenate([c,np.cross(c[:,:,0],c[:,:,1])[:,:,None]],axis=2)\n    rel=np.einsum('nji,njk->nik',rotations(g),rotations(h))\n    angle=np.arccos(np.clip((np.trace(rel,axis1=1,axis2=2)-1)/2,-1,1))\n    base=np.array([r['base'] for r in trace]);bg=np.array([r['base_goal'] for r in trace])\n    fig,axes=plt.subplots(3,2,figsize=(11,10),sharex=True,layout='constrained')\n    axes[0,0].plot(t,np.linalg.norm(h[:,:3]-g[:,:3],axis=1)*1000,label='measured error')\n    axes[0,0].axhline(3,color='green',ls='--',label='3 mm endpoint requirement')\n    axes[0,0].axhline(10,color='red',ls=':',label='10 mm path tube')\n    axes[0,0].set(ylabel='hand position error (mm)')\n    axes[0,1].plot(t,angle,label='measured error')\n    axes[0,1].axhline(.02,color='green',ls='--',label='0.02 rad endpoint requirement')\n    axes[0,1].axhline(.10,color='red',ls=':',label='0.10 rad path tube')\n    axes[0,1].set(ylabel='hand orientation error (rad)')\n    axes[1,0].plot(t,np.linalg.norm(base[:,:2]-bg[:,:2],axis=1)*1000,label='planar goal error')\n    axes[1,0].set(ylabel='base XY goal error (mm)')\n    axes[1,1].plot(t,np.arctan2(np.sin(base[:,2]-bg[:,2]),np.cos(base[:,2]-bg[:,2])),label='heading goal error')\n    axes[1,1].set(ylabel='base heading goal error (rad)')\n    for key,label in [('joint_velocity','measured'),('commanded_joint_velocity','commanded')]:\n        axes[2,0].plot(t,np.sqrt(np.mean(np.array([r[key] for r in trace])**2,axis=1)),label=label)\n    axes[2,0].set(ylabel='arm velocity RMS over joints (rad/s)')\n    axes[2,1].plot(t,[r['force'] for r in trace],label='running peak contact load')\n    axes[2,1].axhline(30,color='red',ls=':',label='existing contact force limit')\n    axes[2,1].set(ylabel='contact load (N)')\n    for ax in axes.flat:\n        ax.grid(alpha=.2);ax.legend(fontsize=7)\n    for ax in axes[-1]:ax.set_xlabel('simulation time (s)')\n    result='PASS' if ep['success'] else 'STOP: '+str(ep.get('robot_failure'))\n    fig.suptitle(f\"{ep['case']['id']} | {ep['controller']} | {ep['selector']}\\n{result}; privileged simulation, no hardware\",fontsize=11)\n    fig.savefig(path,dpi=150);plt.close(fig)\n\nscreen=json.loads(gzip.decompress((root/'screen.json.gz').read_bytes()))\nactual=json.loads(gzip.decompress((root/'real_agent.json.gz').read_bytes()))\nplot(screen['episodes'][0],root/'reference_agent_delivery.png')\nplot(actual['episodes'][0],root/'learned_agent_lift.png')\nprint('Plotted backend-labelled measured position/orientation/base/velocity/contact traces',flush=True)\n",
    "scope": "Backend-labelled measured errors; endpoint lines apply at endpoints, path lines during execution. Base plots show per-stage goal error, not a full 6D body drift certificate."
  },
  "summary_note": "Human summaries omit array-valued stage detail; complete original reports and exact checkpoint manifests remain in the checksummed gzip archives."
}
