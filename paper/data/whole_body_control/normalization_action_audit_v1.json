  "driver_source": "\"\"\"Offline 2x2 action counterfactuals on fixed recorded observations; no rollout guarantee.\"\"\"\nimport gzip,hashlib,json\nfrom pathlib import Path\nimport numpy as np\nimport torch\nfrom stable_baselines3 import PPO\n\ntorch.set_num_threads(1)\nsource=Path('logs/manipulation/tamp-pose-precision-v9/seed-64/step-65536')\nroot=Path('logs/manipulation/tamp-goal-gated-precision-v10')\noriginal=json.loads(gzip.decompress(Path('logs/eval/goal-gated-pair-v10-20261025/report.json.gz').read_bytes()))\nout=Path('logs/eval/normalization-action-audit-20261026');out.mkdir(parents=True,exist_ok=False)\n\ndef predict(model,m,observations):\n obs={k:np.asarray([o[k] for o in observations],dtype=np.float32) for k in observations[0]}\n for key,values in obs.items():\n  n=m['normalization'][key];obs[key]=np.clip((values-np.asarray(n['mean']))/np.sqrt(np.asarray(n['var'])+m['epsilon']),-m['clip'],m['clip']).astype(np.float32)\n return model.predict(obs,deterministic=True)[0]\nbase_model=PPO.load(source/'policy.zip',device='cpu');base_manifest=json.loads((source/'manifest.json').read_text())\nreport={'scope':__doc__,'source':str(source),'source_weights_sha256':base_manifest['weights_sha256'],'variants':{},'driver_source':Path(__file__).read_text(),'safety_promoted':False}\nfor name in ['control','goal_gated']:\n final=root/name/'seed-64/step-16384';model=PPO.load(final/'policy.zip',device='cpu');m=json.loads((final/'manifest.json').read_text());rows=[]\n for row in original['variants'][name]['pose_rows']:\n  ts=[t for t in row['trace'] if 'actor_observation' in t];obs=[t['actor_observation'] for t in ts]\n  old_old=predict(base_model,base_manifest,obs);old_new=predict(base_model,m,obs);new_old=predict(model,base_manifest,obs);new_new=predict(model,m,obs)\n  recorded=np.array([t['normalized_action'] for t in ts]);reproduction=float(np.max(abs(recorded-new_new)))\n  assert reproduction<1e-5,(name,row['case_id'],row['kind'],reproduction)\n  def diff(a,b):\n   d=a-b\n   return {'arm_rms':float(np.sqrt(np.mean(d[:,:5]**2))),'base_rms':float(np.sqrt(np.mean(d[:,6:]**2))),'per_action_rms':np.sqrt(np.mean(d**2,axis=0)).tolist()}\n  rows.append({'case':row['case_id'],'kind':row['kind'],'samples':len(ts),'recorded_actions_max_error':reproduction,\n   'normalization_only':diff(old_new,old_old),'weights_only':diff(new_old,old_old),'combined':diff(new_new,old_old),\n   'normalization_effect_on_new_weights':diff(new_new,new_old)})\n  print(name,row['kind'],row['case_id'],'arm_rms_norm_only',rows[-1]['normalization_only']['arm_rms'],'weights_only',rows[-1]['weights_only']['arm_rms'],'combined',rows[-1]['combined']['arm_rms'],flush=True)\n report['variants'][name]={'checkpoint':str(final),'weights_sha256':m['weights_sha256'],'rows':rows}\nreport['complete']=True\nraw=(json.dumps(report,indent=2,allow_nan=False)+'\\n').encode();(out/'report.json').write_bytes(raw)\nprint('AUDIT_COMPLETE',hashlib.sha256(raw).hexdigest(),flush=True)\n",
