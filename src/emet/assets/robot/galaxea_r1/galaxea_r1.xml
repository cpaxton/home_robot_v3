        <joint name="steer_motor_joint2" class="steer" axis="0 0 1" range="-1.5708 1.5708"/>
        <geom type="mesh" mesh="steer_motor_link2" class="visual" rgba="0.4 0.4 0.4 1"/>
        <body name="wheel_motor_link2" pos="0 0 -0.09525">
          <inertial pos="0 -0.0016 0" mass="5" diaginertia="0.0016 9e-4 9e-4"/>
          <joint name="wheel_motor_joint2" class="wheel" axis="0 1 0"/>
          <geom type="mesh" mesh="wheel_motor_link2" class="visual" rgba="0.6 0.67 0.69 1"/>
