                    <geom type="mesh" mesh="left_arm_link3" class="visual" rgba="0.79 0.82 0.93 1"/>
                    <body name="left_arm_link4" pos="0.02735 0.069767 0" gravcomp="1">
                      <inertial pos="0.243 0.002 0" mass="0.698" diaginertia="1e-4 9.7e-5 8.4e-5"/>
                      <joint name="left_arm_joint4" class="arm_distal" axis="1 0 0" range="-2.8798 2.8798"/>
                      <geom type="mesh" mesh="left_arm_link4" class="visual" rgba="1 1 1 1"/>
                      <body name="left_arm_link5" pos="0.2463 -0.00049894 0" gravcomp="1">
                        <inertial pos="0.054 0.004 0" mass="0.417" diaginertia="1.1e-4 1.1e-4 7.3e-5"/>
                        <joint name="left_arm_joint5" class="arm_distal" axis="0 1 0" range="-1.6581 1.6581"/>
                        <geom type="mesh" mesh="left_arm_link5" class="visual" rgba="1 1 1 1"/>
                        <body name="left_arm_link6" pos="0.058249 0.00050025 0" gravcomp="1">
                          <inertial pos="0.070 -0.010 0.014" mass="0.816" diaginertia="0.0011 0.0011 0.0002"/>
                          <joint name="left_arm_joint6" class="arm_distal" axis="1 0 0" range="-2.8798 2.8798"/>
                          <geom type="mesh" mesh="left_arm_link6" class="visual" rgba="0.82 0.82 1 1"/>
                          <!-- Left wrist RealSense (fixed) -->
                          <body name="left_realsense_link" pos="0.098768 0.0021071 0.05055" quat="0.382254 -0.594878 0.597837 -0.377614">
                            <geom type="mesh" mesh="left_realsense_link" class="visual" rgba="0.8 0.8 0.8 1"/>
                            <camera name="left_camera" pos="0 0 0" fovy="70"/>
                          </body>
                          <!-- Left gripper -->
                          <geom pos="0.1039 0 0" type="mesh" mesh="left_gripper_link" class="visual" rgba="0.82 0.82 1 1"/>
                          <body name="left_gripper_finger_link1" pos="0.14079 0.013453 0.00012067">
                            <inertial pos="-0.020 -0.015 0.005" mass="0.027" diaginertia="6.5e-6 5.8e-6 2.4e-6"/>
                            <joint name="left_gripper_finger_joint1" class="gripper" axis="0 1 0" type="slide" range="0 0.05"/>
                            <geom type="mesh" mesh="left_gripper_finger_link1" class="visual" rgba="0.82 0.82 1 1"/>
                          </body>
                          <body name="left_gripper_finger_link2" pos="0.14079 -0.013453 -0.00012053">
                            <inertial pos="-0.020 0.015 -0.005" mass="0.027" diaginertia="6.5e-6 5.8e-6 2.4e-6"/>
                            <joint name="left_gripper_finger_joint2" class="gripper" axis="0 -1 0" type="slide" range="0 0.05"/>
                            <geom type="mesh" mesh="left_gripper_finger_link2" class="visual" rgba="0.82 0.82 1 1"/>
                          </body>
                        </body>
                      </body>
                    </body>
                  </body>
                </body>
              </body>

              <!-- RIGHT ARM: 6-DOF + gripper -->
              <body name="right_arm_link1" pos="-0.00033672 -0.141835 0.30285" gravcomp="1">
                <inertial pos="0 -0.105 0.002" mass="1.164" diaginertia="0.00116 0.00113 0.00108"/>
                <joint name="right_arm_joint1" class="arm_proximal" axis="0 -1 0" range="-2.8798 2.8798"/>
