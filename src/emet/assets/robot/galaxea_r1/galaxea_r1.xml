<mujoco model="galaxea_r1">
  <compiler angle="radian" assetdir="meshes" balanceinertia="true"/>

  <option integrator="implicitfast" impratio="20" cone="elliptic">
    <flag multiccd="enable"/>
  </option>
  <size njmax="5000" nconmax="5000"/>

  <default>
    <default class="visual">
      <geom contype="0" conaffinity="0" group="1"/>
    </default>
    <default class="collision">
      <geom group="3" type="mesh"/>
    </default>
    <default class="wheel">
      <joint damping="5" armature="0.01"/>
      <velocity gear="3" kv="20" ctrlrange="-6 6"/>
    </default>
    <default class="steer">
      <joint damping="5" armature="0.01"/>
      <position kp="200" kv="20" ctrlrange="-1.5708 1.5708"/>
    </default>
    <default class="torso">
      <joint damping="20" stiffness="0.02" armature="0.01" frictionloss="0.5"/>
      <general gainprm="300" biasprm="0 -150 -50" forcerange="-100 100"/>
    </default>
    <default class="arm_proximal">
      <joint damping="8" armature="0.005" frictionloss="0.3"/>
      <general gainprm="200" biasprm="0 -100 -30" forcerange="-40 40"/>
    </default>
    <default class="arm_distal">
      <joint damping="3" armature="0.002" frictionloss="0.1"/>
      <general gainprm="80" biasprm="0 -40 -10" forcerange="-7 7"/>
    </default>
    <default class="gripper">
      <joint damping="1" armature="0.001"/>
      <position kp="100" ctrlrange="0 0.05"/>
    </default>
  </default>

  <asset>
    <mesh name="base_link" file="base_link.STL"/>
    <mesh name="steer_motor_link1" file="steer_motor_link1.STL"/>
    <mesh name="wheel_motor_link1" file="wheel_motor_link1.STL"/>
    <mesh name="steer_motor_link2" file="steer_motor_link2.STL"/>
    <mesh name="wheel_motor_link2" file="wheel_motor_link2.STL"/>
    <mesh name="steer_motor_link3" file="steer_motor_link3.STL"/>
    <mesh name="wheel_motor_link3" file="wheel_motor_link3.STL"/>
    <mesh name="torso_link1" file="torso_link1.STL"/>
    <mesh name="torso_link2" file="torso_link2.STL"/>
    <mesh name="torso_link3" file="torso_link3.STL"/>
    <mesh name="torso_link4" file="torso_link4.STL"/>
    <mesh name="zed_link" file="zed_link.STL"/>
    <mesh name="left_arm_base_link" file="left_arm_base_link.STL"/>
    <mesh name="left_arm_link1" file="left_arm_link1.STL"/>
    <mesh name="left_arm_link2" file="left_arm_link2.STL"/>
    <mesh name="left_arm_link3" file="left_arm_link3.STL"/>
    <mesh name="left_arm_link4" file="left_arm_link4.STL"/>
    <mesh name="left_arm_link5" file="left_arm_link5.STL"/>
    <mesh name="left_arm_link6" file="left_arm_link6.STL"/>
    <mesh name="left_realsense_link" file="left_realsense_link.STL"/>
    <mesh name="left_gripper_link" file="left_gripper_link.STL"/>
    <mesh name="left_gripper_finger_link1" file="left_gripper_finger_link1.STL"/>
    <mesh name="left_gripper_finger_link2" file="left_gripper_finger_link2.STL"/>
    <mesh name="right_arm_base_link" file="right_arm_base_link.STL"/>
    <mesh name="right_arm_link1" file="right_arm_link1.STL"/>
    <mesh name="right_arm_link2" file="right_arm_link2.STL"/>
    <mesh name="right_arm_link3" file="right_arm_link3.STL"/>
    <mesh name="right_arm_link4" file="right_arm_link4.STL"/>
    <mesh name="right_arm_link5" file="right_arm_link5.STL"/>
    <mesh name="right_arm_link6" file="right_arm_link6.STL"/>
    <mesh name="right_realsense_link" file="right_realsense_link.STL"/>
    <mesh name="right_gripper_link" file="right_gripper_link.STL"/>
    <mesh name="right_gripper_finger_link1" file="right_gripper_finger_link1.STL"/>
    <mesh name="right_gripper_finger_link2" file="right_gripper_finger_link2.STL"/>
  </asset>

  <worldbody>
    <body name="base_link" gravcomp="1">
      <freejoint name="base_freejoint"/>
      <geom type="mesh" mesh="base_link" class="visual" rgba="0.82 0.82 1 1"/>
      <geom type="mesh" mesh="base_link" class="collision"/>

      <!-- Swerve drive: 3 steerable wheels -->
      <body name="steer_motor_link1" pos="0.21516 0.28 0.12375">
