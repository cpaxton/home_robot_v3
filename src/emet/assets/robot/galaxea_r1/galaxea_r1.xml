      </body>

      <body name="steer_motor_link3" pos="-0.28084 0 0.12375">
        <inertial pos="-0.001 -0.034 -0.035" mass="1.2" diaginertia="1e-4 9e-5 7.4e-5"/>
        <joint name="steer_motor_joint3" class="steer" axis="0 0 1" range="-1.5708 1.5708"/>
        <geom type="mesh" mesh="steer_motor_link3" class="visual" rgba="0.4 0.4 0.4 1"/>
