      </body>

      <!-- Torso: 4-DOF chain (pitch-pitch-pitch-yaw) -->
      <body name="torso_link1" pos="-0.032845 0 0.301" gravcomp="1">
        <inertial pos="0.0007 0.003 0.231" mass="5.72" diaginertia="0.109 0.107 0.008"/>
        <joint name="torso_joint1" class="torso" axis="0 1 0" range="-1.1345 1.8326"/>
        <geom type="mesh" mesh="torso_link1" class="visual" rgba="0.37 0.37 0.37 1"/>
        <body name="torso_link2" pos="0 0 0.4" gravcomp="1">
          <inertial pos="0.005 0.014 0.157" mass="3.5" diaginertia="0.028 0.026 0.002"/>
          <joint name="torso_joint2" class="torso" axis="0 1 0" range="-2.7925 2.5307"/>
