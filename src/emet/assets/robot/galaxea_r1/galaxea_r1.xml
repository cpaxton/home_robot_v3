          <body name="torso_link3" pos="0 0 0.3" gravcomp="1">
            <inertial pos="0 -0.009 0.004" mass="3.4" diaginertia="0.0022 0.0014 0.0013"/>
            <joint name="torso_joint3" class="torso" axis="0 -1 0" range="-1.8326 1.5708"/>
            <geom type="mesh" mesh="torso_link3" class="visual" rgba="0.37 0.37 0.37 1"/>
            <body name="torso_link4" pos="0 0 0.09962" gravcomp="1">
              <inertial pos="0.163 0.012 0.011" mass="12.766" diaginertia="0.602 0.568 0.052"/>
              <joint name="torso_joint4" class="torso" axis="0 0 1" range="-3.0543 3.0543"/>
              <geom type="mesh" mesh="torso_link4" class="visual" rgba="0.82 0.82 1 1"/>

              <!-- ZED stereo camera (head, fixed) -->
              <body name="zed_link" pos="0.065512 0.060005 0.47598" quat="0.405568 -0.579235 0.579237 -0.40557">
                <geom type="mesh" mesh="zed_link" class="visual" rgba="0.81 0.84 0.91 1"/>
                <!-- MuJoCo <camera> (not site) so Renderer/update_scene can bind to this frame. -->
                <camera name="zed_camera" pos="0 0 0" fovy="70"/>
              </body>

              <!-- Arm base visual geoms (fixed) -->
              <geom pos="0.00077694 0.097234 0.30285" type="mesh" mesh="left_arm_base_link" class="visual" rgba="0.79 0.82 0.93 1"/>
              <geom pos="0.00077778 -0.097235 0.30285" type="mesh" mesh="right_arm_base_link" class="visual" rgba="0.79 0.82 0.93 1"/>

              <!-- LEFT ARM: 6-DOF + gripper -->
              <body name="left_arm_link1" pos="-0.00033796 0.141834 0.30285" gravcomp="1">
                <inertial pos="0 0.105 -0.002" mass="1.164" diaginertia="0.00116 0.00113 0.00108"/>
                <joint name="left_arm_joint1" class="arm_proximal" axis="0 1 0" range="-2.8798 2.8798"/>
                <geom type="mesh" mesh="left_arm_link1" class="visual" rgba="0.79 0.82 0.93 1"/>
                <body name="left_arm_link2" pos="0 0.1061 0" gravcomp="1">
