          <joint name="wheel_motor_joint1" class="wheel" axis="0 1 0"/>
          <geom type="mesh" mesh="wheel_motor_link1" class="visual" rgba="0.6 0.67 0.69 1"/>
        </body>
      </body>

      <body name="steer_motor_link2" pos="0.21516 -0.28 0.12375">
