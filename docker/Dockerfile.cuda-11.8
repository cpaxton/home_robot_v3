# Stretch AI GPU (CUDA 11.8) image. Uses uv + install.sh (no conda).
# Build with submodules populated: e.g. git submodule update --init --recursive third_party/segment-anything-2
# Then: docker build -t stretch-ai_cuda-11.8:latest . -f docker/Dockerfile.cuda-11.8

FROM nvidia/cuda:11.8.0-base-ubuntu22.04

# Set up timezone
ENV TZ=UTC
RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone

# Install basic dependencies (matches install.sh system deps)
RUN apt-get update && apt-get install -y \
    build-essential \
    curl \
    git \
    git-lfs \
    wget \
    unzip \
    libsndfile1 \
    && rm -rf /var/lib/apt/lists/*

# Install Python 3
RUN apt-get update && apt-get install -y \
    python3 \
    python3-pip \
    python3-dev \
    python-is-python3 \
    && rm -rf /var/lib/apt/lists/*

# OpenCV / video
RUN apt-get update && apt-get install -y \
    ffmpeg \
    libsm6 \
    libxext6 \
    && rm -rf /var/lib/apt/lists/*

# Audio (PyAudio)
RUN apt-get update && apt-get install -y \
    libasound-dev \
    portaudio19-dev \
    libportaudio2 \
    libportaudiocpp0 \
    && rm -rf /var/lib/apt/lists/*

# Network and TTS
RUN apt-get update && apt-get install -y \
    iputils-ping \
    espeak \
    && rm -rf /var/lib/apt/lists/*

# Rerun / GUI
RUN apt-get update && apt-get install -y \
    libxkbcommon-x11-0 \
    && rm -rf /var/lib/apt/lists/*

# Indicate we are in Docker (install.sh can skip linking to ~/.local/bin)
ENV DOCKER=1

WORKDIR /app

# Copy repo (expect submodules already in context from builder, or init in install.sh)
COPY . .

# Run install (uv-based); -y = non-interactive
RUN chmod +x install.sh && ./install.sh -y

# Ensure .venv is on PATH so `emet` and `python` work without activating
ENV PATH="/app/.venv/bin:$PATH"

# Verify install
RUN python -c "import emet; print('emet:', emet.__file__)" && emet --help > /dev/null

CMD ["/bin/bash"]
