{
  "schema_version": 1,
  "status": "development_protocol",
  "executable_registry": false,
  "engine": "mujoco",
  "plan": "docs/plans/2026-11-01_tamp_sim_realism.md",
  "primary_track": {"robot_track": "upstream", "robot": "Panda", "suite": "robosuite"},
  "transfer_track": {"robot_track": "sourccey", "robot": "sourccey", "status": "native_task_adapter_required"},
  "excluded_robots": ["stretch"],
  "agent": "production_chat",
  "vlm_host": "caliban",
  "local_vlm": false,
  "r1_joint_path_controller_binding": "required_before_case_freeze",
  "reference_diagnostic": {
    "script": "scripts/eval_tamp_panda_reference.py",
    "tasks": ["Lift", "Stack"],
    "seeds": [7, 13],
    "policies": ["scripted_reference", "hold"],
    "native_horizon": 1000,
    "diagnostic_step_cap": 400,
    "control_hz": 20,
    "settled_samples": 30,
    "benchmark_or_agent_score": false
  },
  "stages": [
    {"id": "R0", "name": "native_contact_reference", "inputs": "privileged", "execution": "native_stepped", "gate": "retained_lift_and_released_settled_placement; negative_control_fails"},
    {"id": "R1", "name": "shared_tamp_exact_geometry", "inputs": "privileged", "execution": "native_stepped", "gate": "same_public_tools; full_arm_and_payload_paths; certified_reference_replays"},
    {"id": "R2", "name": "clutter_and_causal_composition", "inputs": "privileged", "execution": "native_stepped", "gate": "detours_buffer_moves_protected_goals; fixed_population"},
    {"id": "R3", "name": "rgbd_geometry_with_oracle_masks", "inputs": "privileged", "geometry": "measured_rgbd", "assistance": ["oracle_instance_masks"], "execution": "native_stepped", "gate": "qualified_camera_robot_map_contact_contract; no_scene_object_pose_fallback"},
    {"id": "R4", "name": "observed_grounding_and_tracking", "inputs": "observed", "execution": "native_stepped", "gate": "caliban_grounding; measured_tracking; unknown_space_and_loss_stop"},
    {"id": "R5", "name": "timing_and_physics_sensitivity", "inputs": "observed", "execution": "live_async", "gate": "paired_async_control; stale_delayed_dropped_observations; bounded_contact_parameter_variations"}
  ],
  "invariants": {
    "native_actuation_for_all_execution_stages": true,
    "attachments_or_pose_teleports_during_execution": false,
    "state_initialization_only_at_reset": true,
    "upstream_success_preserved": true,
    "strict_physical_checks_reported_separately": true,
    "same_agent_model_prompts_and_tool_schemas_across_conditions": true,
    "same_frozen_cases_across_matched_conditions": true,
    "reference_replays_per_certified_case": 2,
    "posthoc_agent_failure_exclusion": false,
    "hardware_noise_or_contact_calibration_claimed": false
  },
  "task_complexity_axis": ["single_transfer", "buffered_swap", "clear_then_place", "multi_object_collection"],
  "suite_progression": ["robosuite", "robocasa", "molmospaces"],
  "scored_agent_pilot": {"candidate_configurations": 10, "repeats_per_condition": 3, "registry_frozen": false},
  "metrics": ["fixed_population_success", "certified_subset_success", "upstream_success", "strict_goal_and_integrity", "completed_steps", "planning_and_execution_failure_codes", "native_control_steps", "ik_and_llm_calls", "wall_time", "forbidden_assistance_count"],
  "episodes": []
}
