+++ b/ros2_ws/src/maurice_bot/maurice_arm/include/maurice_arm/feedback_units.hpp
@@ -0,0 +1,11 @@
+#pragma once
+#include <cstdint>
+
+namespace maurice_arm {
+// Present Velocity(128), XC330-M288 / XL430-W250 / XC430-W150:
+// 0.229 revolutions/minute per signed register unit, not position ticks/s.
+// https://emanual.robotis.com/docs/en/dxl/x/xc330-m288/#present-velocity128
+constexpr double dynamixelVelocityRadPerSecond(std::int32_t raw) noexcept {
+    return static_cast<double>(raw) * (0.229 * 2.0 * 3.14159265358979323846 / 60.0);
+}
+}  // namespace maurice_arm
