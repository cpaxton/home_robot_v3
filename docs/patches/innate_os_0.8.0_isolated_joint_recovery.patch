@@ -0,0 +1,213 @@
+// SPDX-License-Identifier: Apache-2.0
+#include "mars_arm/arm_node.hpp"
+
+namespace mars_arm {
+namespace {
+constexpr char kSession[] = "/emet/mars/arm";
+// jointEncoder truncates. Rounding a measured position preserves its original tick.
+int measuredEncoder(double angle, size_t joint) {
+    return static_cast<int>(std::lround(2048 + (flippedJoint(joint) ? -angle : angle) * 4096 / (2 * M_PI)));
+}
+}
+
+void MarsArmNode::adoptAppHolds() {
+    const auto [positions, velocities, loads] = robot_->readState();
+    for (size_t i = 0; i < joint_configs_.size(); ++i) {
+        const int id = joint_configs_[i].servo_id;
+        const auto [low, high] = dynamixel_->readPositionLimits(id);
+        const int goal = dynamixel_->readGoalPosition(id);
+        if (!dynamixel_->readTorqueEnabled(id) || dynamixel_->readHardwareErrorStatus(id) ||
+            std::abs(velocities[i]) > 1 || positions[i] < low || positions[i] > high || goal < low || goal > high) {
+            throw std::runtime_error("App handoff requires stationary, in-range, already-powered servos");
+        }
+        if (i < 6) {
+            const auto position = jointRad(positions[i], i);
+            if (clampToJointRange(i, position) != position || (i == 1 && position < shoulderMinLimit(jointRad(positions[0], 0)))) {
+                throw std::runtime_error("App handoff pose exceeds the Innate arm range");
+            }
+            latest_target_[i] = jointRad(goal, i);
+        } else {
+            latest_head_command_ = goal;
+        }
+    }
+}
+
+void MarsArmNode::setupAdoptedArm(const std::string& joint) {
+    const auto it = std::find(joint_names_.begin(), joint_names_.end(), joint);
+    adopted_start_ = this->get_parameter("adopt_recovery_start_rad").as_double_array();
+    adopted_target_ = this->get_parameter("adopt_recovery_target_rad").as_double();
+    if (it == joint_names_.end() || adopted_start_.size() != 6 || !std::isfinite(adopted_target_) ||
+        !std::all_of(adopted_start_.begin(), adopted_start_.end(), [](double q) { return std::isfinite(q); })) {
+        throw std::runtime_error("Adoption requires a reviewed arm start and target");
+    }
+    adopted_joint_ = static_cast<size_t>(it - joint_names_.begin());
+    if (adopted_joint_ >= kArmJoints || std::abs(adopted_target_ - adopted_start_[adopted_joint_]) > 0.025 ||
+        clampToJointRange(adopted_joint_, adopted_target_) != adopted_target_) {
+        throw std::runtime_error("Adopted arm target exceeds its bounded recovery stroke");
+    }
+    for (const auto& config : joint_configs_) {
+        const int id = config.servo_id;
+        if (!dynamixel_->readTorqueEnabled(id) || dynamixel_->readHardwareErrorStatus(id)) {
+            throw std::runtime_error("Adoption requires healthy, already-powered servos");
+        }
+        adopted_goals_.push_back(dynamixel_->readGoalPosition(id));
+    }
+    const auto [positions, velocities, loads] = robot_->readState();
+    for (size_t i = 0; i < adopted_start_.size(); ++i) {
+        if (positions[i] != measuredEncoder(adopted_start_[i], i) || std::abs(velocities[i]) > 1) {
+            throw std::runtime_error("Adopted arm differs from the reviewed stationary pose");
+        }
+    }
+    const int id = joint_configs_[adopted_joint_].servo_id;
+    adopted_limits_ = dynamixel_->readPositionLimits(id);
+    if (!RecoveryPath{adopted_joint_, {}, adopted_target_}.stopRangeIncludes(
+            measuredEncoder(adopted_start_[adopted_joint_], adopted_joint_), jointEncoder(adopted_target_, adopted_joint_),
+            adopted_limits_.first, adopted_limits_.second)) {
+        throw std::runtime_error("Adopted start or target exceeds the native encoder range");
+    }
+
+    const auto trigger = [this](const char* path, auto callback) {
+        return this->create_service<std_srvs::srv::Trigger>(
+            std::string(kSession) + path,
+            [callback](const std_srvs::srv::Trigger::Request::SharedPtr, std_srvs::srv::Trigger::Response::SharedPtr reply) {
+                try {
+                    reply->success = callback();
+                    reply->message = reply->success ? "confirmed" : "adopted arm request rejected";
+                } catch (const std::exception& error) {
+                    reply->message = error.what();
+                }
+            }, rmw_qos_profile_services_default, stop_callback_group_);
+    };
+    adopt_acquire_ = trigger("/acquire", [this] {
+        std::lock_guard<std::mutex> bus(dynamixel_mutex_);
+        if (adopted_lease_ || adopted_fault_ || servo_tripped_ || !arm_torque_enabled_) {
+            return false;
+        }
+        adopted_lease_ = true;
+        return true;
+    });
+    adopt_hold_ = trigger("/hold", [this] {
+        std::lock_guard<std::mutex> bus(dynamixel_mutex_);
+        return adopted_lease_ && holdAdoptedArm();
+    });
+    adopt_release_ = trigger("/release", [this] {
+        std::lock_guard<std::mutex> bus(dynamixel_mutex_);
+        if (!holdAdoptedArm()) {
+            return false;
+        }
+        adopted_lease_ = false;
+        return true;
+    });
+    arm_goto_js_v2_service_ = this->create_service<mars_msgs::srv::GotoJS>(
+        std::string(kSession) + "/goto_js_v2",
+        [this](const mars_msgs::srv::GotoJS::Request::SharedPtr req, mars_msgs::srv::GotoJS::Response::SharedPtr reply) {
+            std::optional<uint64_t> claim;
+            try {
+                std::lock_guard<std::mutex> bus(dynamixel_mutex_);
+                const auto& q = req->data.data;
+                if (!adopted_lease_ || adopted_fault_ || servo_tripped_ || !arm_torque_enabled_ ||
+                    q.size() != 6 || !std::isfinite(req->time) || req->time < 1.0 || req->time > 2.0) {
+                    return;
+                }
+                for (size_t i = 0; i < q.size(); ++i) {
+                    const double expected = i == adopted_joint_ ? adopted_target_ : adopted_start_[i];
+                    if (!std::isfinite(q[i]) || std::abs(q[i] - expected) > 1e-6) {
+                        return;
+                    }
+                }
+                auto [positions, velocities, loads] = robot_->readState();
+                for (size_t i = 0; i < q.size(); ++i) {
+                    if (positions[i] != measuredEncoder(adopted_start_[i], i) || std::abs(velocities[i]) > 1) {
+                        return;
+                    }
+                }
+                // A gain change can move a powered joint against its existing
+                // goal before the first trajectory waypoint reaches the bus.
+                // Preserve the gains that are maintaining the adopted hold.
+                const int id = joint_configs_[adopted_joint_].servo_id;
+                dynamixel_->setRecoveryProfile(id);
+                claim = claimArm();
+            } catch (const std::exception& error) {
+                RCLCPP_ERROR(this->get_logger(), "Adopted arm admission failed: %s", error.what());
+                return;
+            }
+            reply->success = planAndExecuteTrajectory(req->data.data, req->time, GainMode::SCHEDULED, claim);
+        }, rmw_qos_profile_services_default, service_callback_group_);
+}
+
+bool MarsArmNode::holdAdoptedArm() {
+    // Caller holds the bus. Invalidate the native trajectory before a hold write.
+    bool active;
+    {
+        std::lock_guard<std::mutex> command(arm_command_mutex_);
+        active = has_target_;
+        has_target_ = false;
+        target_pending_ = false;
+        ++arm_claim_;
+    }
+    if (!active) {
+        return !adopted_fault_;
+    }
+    auto [positions, velocities, loads] = robot_->readState();
+    const int id = joint_configs_[adopted_joint_].servo_id;
+    const auto [low, high] = adopted_limits_;
+    const int encoder = positions[adopted_joint_];
+    if (!dynamixel_->readTorqueEnabled(id) || !RecoveryPath::canHoldEncoder(encoder, low, high)) {
+        adopted_fault_ = true;
+        return false;
+    }
+    adopted_goals_[adopted_joint_] = std::clamp(encoder, low, high);
+    dynamixel_->writeRecoveryTarget(id, adopted_goals_[adopted_joint_]);
+    return !adopted_fault_;
+}
+
+void MarsArmNode::tickAdoptedArm(const std::vector<int>& positions, const std::vector<int>& velocities,
+                                const std::vector<int>& loads) {
+    double goal;
+    {
+        std::lock_guard<std::mutex> command(arm_command_mutex_);
+        target_pending_ = false;
+        if (!adopted_lease_ || !has_target_ || adopted_fault_) {
+            return;
+        }
+        goal = latest_target_[adopted_joint_];
+    }
+    const auto joint = adopted_joint_;
+    const int id = joint_configs_[joint].servo_id;
+    for (size_t i = 0; i < 6; ++i) {
+        if (i != joint && std::abs(positions[i] - measuredEncoder(adopted_start_[i], i)) > 1) {
+            RCLCPP_WARN(this->get_logger(), "Staging stopped: joint %zu moved to encoder %d (start %d)",
+                        i + 1, positions[i], measuredEncoder(adopted_start_[i], i));
+            holdAdoptedArm();
+            adopted_fault_ = true;
+            return;
+        }
+    }
+    if (!arm_torque_enabled_ || servo_tripped_ || std::abs(loads[joint]) >= kLoadWarningThreshold) {
+        RCLCPP_WARN(this->get_logger(), "Staging stopped: torque %d, fault %d, selected load %d",
+                    static_cast<int>(arm_torque_enabled_.load()), static_cast<int>(servo_tripped_.load()), loads[joint]);
+        holdAdoptedArm();
+        adopted_fault_ = true;
+        return;
+    }
+    const auto [low, high] = adopted_limits_;
+    const int encoder = std::clamp(jointEncoder(goal, joint), low, high);
+    if (velocities.size() != positions.size()) {
+        throw std::runtime_error("Incomplete adopted arm feedback");
+    }
+    const int start = measuredEncoder(adopted_start_[joint], joint);
+    const int target = jointEncoder(adopted_target_, joint);
+    if ((target > start && (positions[joint] < start || positions[joint] > target + 2)) ||
+        (target < start && (positions[joint] > start || positions[joint] < target - 2))) {
+        RCLCPP_WARN(this->get_logger(), "Staging stopped: selected encoder %d left interval %d to %d",
+                    positions[joint], start, target);
+        holdAdoptedArm();
+        adopted_fault_ = true;
+        return;
+    }
+    if (encoder != adopted_goals_[joint]) {
+        dynamixel_->writeRecoveryTarget(id, encoder);
+        adopted_goals_[joint] = encoder;
+    }
+}
+}
