@@ -0,0 +1,216 @@
+// SPDX-License-Identifier: Apache-2.0
+#include "mars_arm/arm_node.hpp"
+
+namespace mars_arm {
+namespace {
+
+using Recovery = control_msgs::action::FollowJointTrajectory;
+using GoalHandle = rclcpp_action::ServerGoalHandle<Recovery>;
+using Clock = std::chrono::steady_clock;
+
+double seconds(Clock::duration time) {
+    return std::chrono::duration<double>(time).count();
+}
+
+bool stationary(const std::vector<int>& velocity) {
+    return velocity.size() >= 6
+        && std::all_of(velocity.begin(), velocity.begin() + 6, [](int v) { return v >= -1 && v <= 1; });
+}
+
+}  // namespace
+
+void MarsArmNode::setupIsolatedRecovery(const std::string& joint) {
+    const auto it = std::find(joint_names_.begin(), joint_names_.end(), joint);
+    const auto start = this->get_parameter("isolated_recovery_start_rad").as_double_array();
+    const double target = this->get_parameter("isolated_recovery_target_rad").as_double();
+    if (it == joint_names_.end() || start.size() != 6 || !std::isfinite(target) ||
+        !std::all_of(start.begin(), start.end(), [](double x) { return std::isfinite(x); })) {
+        throw std::invalid_argument("Isolated recovery requires one named joint and a reviewed six-joint start and target");
+    }
+    const auto index = static_cast<size_t>(it - joint_names_.begin());
+    recovery_path_ = RecoveryPath{index, {}, target};
+    std::copy(start.begin(), start.end(), recovery_path_->start.begin());
+    for (size_t i = 0; i < start.size(); ++i) {
+        if (!dynamixel_->readTorqueEnabled(joint_configs_[i].servo_id)) {
+            throw std::runtime_error("Isolated recovery requires the existing arm servo holds");
+        }
+    }
+    recovery_server_ = rclcpp_action::create_server<Recovery>(
+        this, "/mars/arm/recover_joint",
+        [this](const rclcpp_action::GoalUUID&, std::shared_ptr<const Recovery::Goal> goal) {
+            std::lock_guard<std::mutex> lock(recovery_mutex_);
+            const auto& path = *recovery_path_;
+            const auto& names = goal->trajectory.joint_names;
+            const auto& points = goal->trajectory.points;
+            if (recovery_reserved_ || recovery_fault_ || names.size() != 1 ||
+                names[0] != joint_names_[path.joint] || points.size() != 2 ||
+                !goal->multi_dof_trajectory.points.empty() ||
+                !std::all_of(points.begin(), points.end(), [](const auto& point) {
+                    return point.positions.size() == 1 && point.velocities.empty() &&
+                           point.accelerations.empty() && point.effort.empty();
+                }) || rclcpp::Duration(points[0].time_from_start).nanoseconds() != 0 ||
+                !path.matchesGoal(points[0].positions[0], points[1].positions[0],
+                                  rclcpp::Duration(points[1].time_from_start).seconds())) {
+                return rclcpp_action::GoalResponse::REJECT;
+            }
+            recovery_reserved_ = true;
+            return rclcpp_action::GoalResponse::ACCEPT_AND_EXECUTE;
+        },
+        [](const std::shared_ptr<GoalHandle>&) { return rclcpp_action::CancelResponse::ACCEPT; },
+        [this](std::shared_ptr<GoalHandle> goal) {
+            std::lock_guard<std::mutex> lock(recovery_mutex_);
+            recovery_goal_ = std::move(goal);
+        });
+}
+
+void MarsArmNode::finishIsolatedRecovery(int code, const std::string& reason) {
+    auto result = std::make_shared<Recovery::Result>();
+    result->error_code = code;
+    result->error_string = reason;
+    if (code == Recovery::Result::SUCCESSFUL) {
+        recovery_goal_->succeed(result);
+    } else if (recovery_goal_->is_canceling()) {
+        recovery_goal_->canceled(result);
+    } else {
+        recovery_goal_->abort(result);
+    }
+    recovery_goal_.reset();
+    recovery_reserved_ = false;
+    recovery_active_ = false;
+    recovery_holding_ = false;
+    recovery_settle_ = {};
+    if (code == RecoveryPath::stop_unconfirmed) {
+        recovery_fault_ = true;
+    }
+}
+
+void MarsArmNode::tickIsolatedRecovery(const std::vector<int>& encoders, const std::vector<int>& velocity,
+                                      const std::vector<int>& load, const std::vector<double>& positions) {
+    // Caller owns the vendor's bus mutex. No full-arm position write is enabled in this mode.
+    std::lock_guard<std::mutex> lock(recovery_mutex_);
+    if (!recovery_goal_) {
+        return;
+    }
+    const auto& path = *recovery_path_;
+    const auto index = path.joint;
+    const auto id = joint_configs_[index].servo_id;
+    const auto now = Clock::now();
+    const auto armTorqueEnabled = [this] {
+        return std::all_of(joint_configs_.begin(), joint_configs_.begin() + 6, [this](const auto& config) {
+            return dynamixel_->readTorqueEnabled(config.servo_id);
+        });
+    };
+    const auto& points = recovery_goal_->get_goal()->trajectory.points;
+    const double duration = rclcpp::Duration(points[1].time_from_start).seconds();
+    const int target = jointEncoder(path.target, index);
+    if (!recovery_active_) {
+        if (recovery_goal_->is_canceling()) {
+            finishIsolatedRecovery(Recovery::Result::INVALID_GOAL, "Cancelled before any motor command");
+            return;
+        }
+        if (servo_tripped_ || !arm_torque_enabled_ || !stationary(velocity) || !path.matches(positions) ||
+            std::abs(positions[index] - points[0].positions[0]) > RecoveryPath::pose_tolerance ||
+            clampToJointRange(index, path.target) != path.target ||
+            (index == 1 && path.target < shoulderMinLimit(positions[0]))) {
+            finishIsolatedRecovery(Recovery::Result::INVALID_GOAL, "Observed start or native target failed recovery admission");
+            return;
+        }
+        for (const auto& config : joint_configs_) {
+            if (config.servo_id <= 6 && (!dynamixel_->readTorqueEnabled(config.servo_id) ||
+                                         dynamixel_->readHardwareErrorStatus(config.servo_id) != 0)) {
+                finishIsolatedRecovery(Recovery::Result::INVALID_GOAL, "An arm servo cannot maintain its existing hold");
+                return;
+            }
+        }
+        const auto [lower, upper] = dynamixel_->readPositionLimits(id);
+        if (!path.stopRangeIncludes(encoders[index], target, lower, upper)) {
+            finishIsolatedRecovery(Recovery::Result::INVALID_GOAL, "Native servo range cannot hold throughout the stroke");
+            return;
+        }
+        recovery_lower_ = lower;
+        recovery_upper_ = upper;
+        // Conservative velocity-based profile for the selected servo only.
+        dynamixel_->setRecoveryProfile(id);
+        recovery_active_ = true;
+        recovery_encoder_ = std::clamp(encoders[index], lower, upper);
+        recovery_command_ = jointRad(recovery_encoder_, index);
+        if (recovery_encoder_ != encoders[index]) {
+            dynamixel_->writeRecoveryTarget(id, recovery_encoder_);
+        }
+        recovery_last_tick_ = now;
+        recovery_started_ = now;
+        return;
+    }
+
+    const auto selected = positions[index];
+    const auto q = encoders[index];
+    const auto allowed_time = std::max(duration, std::abs(path.target - path.start[index]) / RecoveryPath::rate) + 2.0;
+    const char* stop_reason = nullptr;
+    if (recovery_goal_->is_canceling()) {
+        stop_reason = "Recovery cancelled";
+    } else if (servo_tripped_ || !arm_torque_enabled_) {
+        stop_reason = "Arm health or torque changed";
+    } else if (std::abs(load[index]) >= kLoadWarningThreshold) {
+        stop_reason = "Selected servo load reached the recovery limit";
+    } else if (!path.matches(positions, true)) {
+        stop_reason = "An unselected arm joint moved";
+    } else if (!path.canHoldEncoder(q, recovery_lower_, recovery_upper_)) {
+        stop_reason = "Selected servo left the native recovery range";
+    } else if (std::abs(selected - recovery_command_) > RecoveryPath::max_tracking_error) {
+        stop_reason = "Selected servo fell outside the recovery tracking tolerance";
+    } else if (seconds(now - recovery_started_) > allowed_time) {
+        stop_reason = "Selected servo did not settle at the recovery target before timeout";
+    }
+    if (!recovery_holding_ && stop_reason) {
+        RCLCPP_WARN(this->get_logger(), "%s: measured encoder %d, applied encoder %d, target encoder %d, load %d",
+                    stop_reason, q, recovery_encoder_, target, load[index]);
+        if (!arm_torque_enabled_ || !dynamixel_->readTorqueEnabled(id) ||
+            !path.canHoldEncoder(q, recovery_lower_, recovery_upper_)) {
+            finishIsolatedRecovery(RecoveryPath::stop_unconfirmed, "Measured motor position cannot be held");
+            return;
+        }
+        recovery_encoder_ = std::clamp(q, recovery_lower_, recovery_upper_);
+        dynamixel_->writeRecoveryTarget(id, recovery_encoder_);
+        recovery_holding_ = true;
+        recovery_hold_started_ = now;
+        recovery_settle_ = {};
+    }
+
+    if (!recovery_holding_) {
+        recovery_command_ = path.step(recovery_command_, seconds(now - recovery_last_tick_), duration);
+        recovery_last_tick_ = now;
+        const int next = std::clamp(jointEncoder(recovery_command_, index), recovery_lower_, recovery_upper_);
+        if (next != recovery_encoder_) {
+            dynamixel_->writeRecoveryTarget(id, next);
+            recovery_encoder_ = next;
+        }
+    }
+
+    const bool at_result = recovery_holding_ || recovery_command_ == path.target;
+    const bool held = std::abs(q - recovery_encoder_) <= 2 && stationary(velocity);
+    if (!at_result || !held) {
+        recovery_settle_ = {};
+    } else if (recovery_settle_ == Clock::time_point{}) {
+        recovery_settle_ = now;
+    } else if (seconds(now - recovery_settle_) >= RecoveryPath::settle_seconds) {
+        if (!armTorqueEnabled()) {
+            finishIsolatedRecovery(RecoveryPath::stop_unconfirmed, "An arm servo lost its hold during recovery");
+        } else if (recovery_holding_) {
+            finishIsolatedRecovery(Recovery::Result::PATH_TOLERANCE_VIOLATED, "Recovery halted with a measured hold");
+        } else {
+            finishIsolatedRecovery(Recovery::Result::SUCCESSFUL, "Selected joint returned to the reviewed target and settled");
+        }
+    }
+    if (recovery_holding_ && seconds(now - recovery_hold_started_) > 0.65) {
+        finishIsolatedRecovery(RecoveryPath::stop_unconfirmed, "Recovery halt did not settle");
+    }
+}
+
+void MarsArmNode::isolatedRecoveryReadFailed() {
+    std::lock_guard<std::mutex> lock(recovery_mutex_);
+    if (recovery_goal_) {
+        finishIsolatedRecovery(RecoveryPath::stop_unconfirmed, "Recovery bus write or feedback failed");
+    }
+}
+
+}  // namespace mars_arm
