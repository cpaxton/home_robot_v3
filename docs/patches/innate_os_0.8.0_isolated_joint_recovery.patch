index 0000000..95ff641
--- /dev/null
+++ b/ros2_ws/src/mars_bot/mars_arm/include/mars_arm/isolated_recovery.hpp
@@ -0,0 +1,60 @@
+// SPDX-License-Identifier: Apache-2.0
+#pragma once
+
+#include <algorithm>
+#include <array>
+#include <cmath>
+#include <stdexcept>
+#include <vector>
+
+namespace mars_arm {
+
+struct RecoveryPath {
+    static constexpr double pose_tolerance = 0.005;
+    static constexpr double rate = 0.11;
+    static constexpr double max_tracking_error = 0.020;
+    static constexpr double settle_seconds = 0.25;
+    static constexpr int stop_unconfirmed = -100;
+
+    size_t joint;
+    std::array<double, 6> start;
+    double target;
+
+    bool matches(const std::vector<double>& pose, bool ignore_selected = false) const {
+        if (pose.size() != start.size()) {
+            return false;
+        }
+        for (size_t i = 0; i < start.size(); ++i) {
+            if (!(ignore_selected && i == joint) && !(std::abs(pose[i] - start[i]) <= pose_tolerance)) {
+                return false;
+            }
+        }
+        return true;
+    }
+
+    bool matchesGoal(double requested_start, double requested_target, double duration) const {
+        const double travel = std::abs(target - requested_start);
+        return std::abs(requested_start - start[joint]) <= pose_tolerance
+            && std::abs(requested_target - target) <= 1e-6 && travel > pose_tolerance
+            && std::isfinite(duration) && duration > 0.0 && duration <= 10.0;
+    }
+
+    double step(double present_command, double elapsed, double duration) const {
+        const double limit = std::min(rate, std::abs(target - start[joint]) / duration);
+        const double delta = limit * std::clamp(elapsed, 0.0, 0.04);
+        return present_command + std::clamp(target - present_command, -delta, delta);
+    }
+
+    static bool canHoldEncoder(int measured, int lower, int upper) {
+        // Quantization at the boundary can report one tick beyond the hardware
+        // limit. Only that one tick may use the nearest legal encoder hold.
+        return measured >= lower - 1 && measured <= upper + 1;
+    }
+
+    bool stopRangeIncludes(int begin, int end, int lower, int upper) const {
+        return lower >= 0 && upper <= 4095 && upper >= lower && upper - lower >= 4
+            && canHoldEncoder(begin, lower, upper) && end >= lower + 2 && end <= upper - 2;
+    }
+};
+
+}  // namespace mars_arm
