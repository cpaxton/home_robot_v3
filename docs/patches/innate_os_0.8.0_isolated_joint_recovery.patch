+uint8_t Dynamixel::readRecoveryByte(int motor_id, uint16_t address) {
+    uint8_t value = 0, error = 0;
+    checkComm(packet_handler_->read1ByteTxRx(port_handler_, motor_id, address, &value, &error),
+              motor_id, "read recovery register");
+    if (error != 0) {
+        throw std::runtime_error("Recovery servo rejected register read");
+    }
+    return value;
+}
+
+int Dynamixel::readRecoveryWord(int motor_id, uint16_t address) {
+    uint32_t value = 0;
+    uint8_t error = 0;
+    checkComm(packet_handler_->read4ByteTxRx(port_handler_, motor_id, address, &value, &error),
+              motor_id, "read recovery register");
+    if (error != 0) {
+        throw std::runtime_error("Recovery servo rejected register read");
+    }
+    return toSigned32(value);
+}
+
+bool Dynamixel::readTorqueEnabled(int motor_id) {
+    return readRecoveryByte(motor_id, ADDR_TORQUE_ENABLE) == 1;
+}
+
+std::pair<int, int> Dynamixel::readPositionLimits(int motor_id) {
+    const auto mode = readRecoveryByte(motor_id, OPERATING_MODE_ADDR);
+    if (mode != static_cast<uint8_t>(OperatingMode::POSITION) &&
+        mode != static_cast<uint8_t>(OperatingMode::CURRENT_CONTROLLED_POSITION)) {
+        throw std::runtime_error("Recovery requires a bounded position-control mode");
+    }
+    return {readRecoveryWord(motor_id, ADDR_MIN_POSITION_LIMIT), readRecoveryWord(motor_id, ADDR_MAX_POSITION_LIMIT)};
+}
+
+void Dynamixel::setRecoveryProfile(int motor_id) {
+    // Drive Mode (10) bit 2 selects time-based profiles. Five velocity units
+    // in velocity-based mode correspond to roughly 0.12 rad/s on Mars servos.
+    if ((readRecoveryByte(motor_id, 10) & 4) != 0) {
+        throw std::runtime_error("Recovery requires a velocity-based servo profile");
+    }
+    constexpr int profile = 5;
+    setProfileVelocity(motor_id, profile);
+    if (readRecoveryWord(motor_id, ADDR_PROFILE_VELOCITY) != profile) {
+        throw std::runtime_error("Recovery servo did not apply the bounded velocity profile");
+    }
+}
+
+void Dynamixel::writeRecoveryTarget(int motor_id, int goal_position) {
+    uint8_t error = 0;
+    checkComm(packet_handler_->write4ByteTxRx(port_handler_, motor_id, ADDR_GOAL_POSITION, goal_position, &error),
+              motor_id, "write isolated recovery target");
+    if (error != 0 || readRecoveryWord(motor_id, ADDR_GOAL_POSITION) != goal_position) {
+        throw std::runtime_error("Isolated recovery servo did not apply its position target");
+    }
+}
+
 void Dynamixel::reboot(int motor_id) {
     uint8_t dxl_error = 0;
     int dxl_comm_result = packet_handler_->reboot(port_handler_, motor_id, &dxl_error);
