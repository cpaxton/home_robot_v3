.ropeproject

# mkdocs documentation
/site

# mypy
.mypy_cache/

# Vim stuff
*.swp
*.swn
*.swo

# URDF files
*.urdf

# Webcam calibration images
webcam_calibration_images/

# Data files
*.pkl
*.pcd
*.pt
*.png
*.jpg
*.jpeg
# Allow images in docs and robot assets (repo content)
!docs/**/*.png
!docs/**/*.jpg
!docs/**/*.jpeg
!src/emet/assets/**/*.png
!src/emet/assets/**/*.jpg
!src/emet/assets/**/*.jpeg

# Policy weights and configs
policy/

# Data collection folder
data/
log/
logs/
# Allow tracked branch / PR planning notes under docs/logs/
!docs/logs/
!docs/logs/**
dynamem_log/

# Local sim episode capture dirs (emet dataset capture default names)
ep0/
episode0/

# Third-party sim (cloned by emet install sim / emet install robocasa)
third_party/robocasa/
third_party/robosuite/
third_party/robosuite_models/

# install folder
install/

# MuJoCo / sim runtime artifacts
MUJOCO_LOG.TXT
**/stretch_temp_abs.xml
molmo_videos/
# MolmoSpaces merged MJCF temp files (next to packaged galaxea R1 MJCF for assetdir resolution)
src/emet/assets/robot/galaxea_r1/molmospaces_merged_*.xml
src/emet/assets/robot/galaxea_r1/t_*.xml

# Partial downloads / caches
*.partial

debug*/

*/piper_tts/
piper_tts/
*.ts

# Bytecode dirs: after any `!` negations (e.g. Flask instance/ exception for emet.mapping.instance) so __pycache__ stays ignored.
**/__pycache__/
